{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Jev: Preview request (free, offline)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "jev.py",
        "support",
        "--dry-run"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Jev: Run support example (live API)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "jev.py",
        "support"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Jev: Run offline tests",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Industry: Validate offline",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "evaluate_industry.py",
        "--dry-run"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Industry: Run 13 live cases",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "evaluate_industry.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "E2E: Validate offline",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "pipeline_e2e.py",
        "--dry-run"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "E2E: Run one company (live APIs)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "pipeline_e2e.py",
        "--limit",
        "1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "E2E: Run ten companies (live APIs)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "pipeline_e2e.py",
        "--limit",
        "10"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "E2E: OpenAI judge one company (live APIs)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "pipeline_e2e.py",
        "--judge",
        "openai",
        "--limit",
        "1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
